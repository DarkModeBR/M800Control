<Page x:Class="M800.App.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Desempenho"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PagePanel}">
            <TextBlock Text="Desempenho" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ajustes do sensor e dos botões." Style="{StaticResource PageSubtitle}" />

            <ui:CardControl Icon="{ui:SymbolIcon Flash24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Polling rate" FontWeight="SemiBold" />
                        <TextBlock Text="Quantas vezes por segundo o mouse envia a posição ao computador. 1000 Hz responde mais rápido, mas gasta mais bateria." Style="{StaticResource CardLabel}" MaxWidth="460" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding PollingRates}" SelectedItem="{Binding SelectedPolling}" ItemStringFormat="{}{0} Hz" MinWidth="140" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ArrowAutofitHeight24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Altura de levantamento (LOD)" FontWeight="SemiBold" />
                        <TextBlock Text="Altura acima da mesa em que o sensor para de ler o movimento. 1 mm é o melhor para jogos." Style="{StaticResource CardLabel}" MaxWidth="460" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="1 mm" GroupName="Lod" IsChecked="{Binding Lod1}" Margin="0,0,16,0" />
                    <RadioButton Content="2 mm" GroupName="Lod" IsChecked="{Binding Lod2}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon CursorClick24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Debounce dos botões" FontWeight="SemiBold" />
                        <TextBlock Text="Tempo que o mouse ignora depois de cada clique para evitar repiques. Menor deixa o clique mais rápido; aumente se aparecer clique duplo sozinho." Style="{StaticResource CardLabel}" MaxWidth="460" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="0" Maximum="30" Value="{Binding DebounceMs}" IsSnapToTickEnabled="True" TickFrequency="2" Width="220" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DebounceText}" Width="50" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>

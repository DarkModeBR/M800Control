<Page x:Class="M800.App.Pages.LightingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:M800.App.Controls"
      Title="Iluminação"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PagePanel}">
            <TextBlock Text="Iluminação" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Efeito RGB do mouse. As mudanças aparecem no mouse na hora." Style="{StaticResource PageSubtitle}" />

            <ui:CardControl Icon="{ui:SymbolIcon Lightbulb24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Efeito" FontWeight="SemiBold" />
                        <TextBlock Text="Modo de iluminação" Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Name" MinWidth="240" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon WeatherSunny24}" Margin="0,0,0,8"
                            Visibility="{Binding ShowSpeedAndBrightness, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Brilho" FontWeight="SemiBold" />
                        <TextBlock Text="4 níveis" Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <Slider Minimum="1" Maximum="4" Value="{Binding Brightness}" IsSnapToTickEnabled="True" TickFrequency="1"
                        TickPlacement="BottomRight" Width="240" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon TopSpeed24}" Margin="0,0,0,8"
                            Visibility="{Binding ShowSpeedAndBrightness, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Velocidade" FontWeight="SemiBold" />
                        <TextBlock Text="3 níveis" Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <Slider Minimum="1" Maximum="3" Value="{Binding Speed}" IsSnapToTickEnabled="True" TickFrequency="1"
                        TickPlacement="BottomRight" Width="240" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8"
                            Visibility="{Binding ShowDirection, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Inverter direção" FontWeight="SemiBold" />
                        <TextBlock Text="Sentido do movimento do arco-íris" Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding ReverseDirection}" />
            </ui:CardControl>

            <ui:Card Visibility="{Binding ShowColors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Cores" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ColorsHint}" Style="{StaticResource CardLabel}" Margin="0,2,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Colors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:ColorSwatchButton Color="{Binding Color}" Margin="0,0,8,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Icon="{ui:SymbolIcon Add24}" Command="{Binding AddColorCommand}" ToolTip="Adicionar cor" Margin="8,0,4,0" />
                        <ui:Button Icon="{ui:SymbolIcon Subtract24}" Command="{Binding RemoveColorCommand}" ToolTip="Remover a última cor" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

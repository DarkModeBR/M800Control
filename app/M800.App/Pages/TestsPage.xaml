<Page x:Class="M800.App.Pages.TestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Testes"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="TestArea" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Cursor" Value="Cross" />
        </Style>
        <Style x:Key="BigValue" TargetType="TextBlock" BasedOn="{StaticResource CardValue}">
            <Setter Property="FontSize" Value="34" />
        </Style>
    </Page.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PagePanel}">
            <TextBlock Text="Testes" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ferramentas para conferir o desempenho real do M800. Os outros mouses conectados são ignorados." Style="{StaticResource PageSubtitle}" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Iniciar" Icon="{ui:SymbolIcon Play24}" Appearance="Primary"
                                   Command="{Binding StartPollingCommand}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Polling real" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Conta quantos relatórios de movimento por segundo chegam do mouse ao Windows." Style="{StaticResource CardLabel}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding PollingValue}" Style="{StaticResource BigValue}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding PollingDetail}" Style="{StaticResource CardLabel}" />
                    <Border Style="{StaticResource TestArea}" Height="150">
                        <TextBlock Text="Mexa o mouse aqui em círculos rápidos" Style="{StaticResource CardLabel}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Content="Concluir" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding FinishClicksCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Iniciar" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding StartClicksCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Teste de cliques" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Mede o tempo de cada clique e detecta repique (clique duplo que você não fez), para escolher o menor debounce seguro." Style="{StaticResource CardLabel}" MaxWidth="560" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ClickValue}" Style="{StaticResource BigValue}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding ClickDetail}" Style="{StaticResource CardLabel}" />
                    <Border Style="{StaticResource TestArea}" Height="130">
                        <TextBlock Text="Clique aqui com o botão esquerdo" Style="{StaticResource CardLabel}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <DockPanel Margin="0,12,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="Aplicar debounce sugerido" Icon="{ui:SymbolIcon Checkmark24}"
                                   Command="{Binding ApplySuggestionCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding CanApplySuggestion, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding SuggestionText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

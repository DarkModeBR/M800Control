<Page x:Class="M800.App.Pages.PowerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Energia"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PagePanel}">
            <TextBlock Text="Energia" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Economia de bateria no modo sem fio." Style="{StaticResource PageSubtitle}" />

            <ui:CardControl Icon="{ui:SymbolIcon WeatherMoon24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Dormir depois de" FontWeight="SemiBold" />
                        <TextBlock Text="Tempo parado até o mouse entrar em modo de economia." Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider Minimum="3" Maximum="10" Value="{Binding SleepMinutes}" IsSnapToTickEnabled="True" TickFrequency="1" Width="220" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SleepText}" Width="90" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon LightbulbFilament24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Apagar o LED ao mover" FontWeight="SemiBold" />
                        <TextBlock Text="Desliga a iluminação enquanto o mouse está em movimento." Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding LightOffWhileMoving}" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon CursorHover24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Acordar ao mover" FontWeight="SemiBold" />
                        <TextBlock Text="Se desligado, o mouse só acorda com um clique." Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding MotionWakeup}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>

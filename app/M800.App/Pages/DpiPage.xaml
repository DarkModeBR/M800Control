<Page x:Class="M800.App.Pages.DpiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:M800.App.Controls"
      xmlns:common="clr-namespace:M800.App.Common"
      Title="DPI"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="LevelSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="8,0,16,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding (common:Responsive.IsNarrow), RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="6" />
                    <Setter Property="Margin" Value="0,8,0,2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PagePanel}">
            <TextBlock Text="DPI" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding RangeText}" Style="{StaticResource PageSubtitle}" />

            <Grid Margin="16,0,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ativo" Style="{StaticResource CardLabel}" />
                <TextBlock Grid.Column="3" Text="DPI" Style="{StaticResource CardLabel}" />
                <TextBlock Grid.Column="4" Text="Cor" Style="{StaticResource CardLabel}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="Ligado" Style="{StaticResource CardLabel}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Levels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8" Padding="16,10">
                            <Grid common:Responsive.NarrowBelow="540">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton GroupName="DpiActive" IsChecked="{Binding IsActive}" IsEnabled="{Binding Enabled}"
                                             VerticalAlignment="Center" ToolTip="Usar este nível agora" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Slider Style="{StaticResource LevelSlider}" Minimum="0" Maximum="{Binding SliderMax}" Value="{Binding SliderIndex}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                        IsEnabled="{Binding Enabled}" VerticalAlignment="Center" />
                                <ui:NumberBox Grid.Column="3" Value="{Binding DpiValue, UpdateSourceTrigger=LostFocus}"
                                              Minimum="{Binding MinDpi}" Maximum="{Binding MaxDpi}" SmallChange="50" LargeChange="500"
                                              MaxDecimalPlaces="0" IsEnabled="{Binding Enabled}" VerticalAlignment="Center" />
                                <controls:ColorSwatchButton Grid.Column="4" Color="{Binding Color}" HorizontalAlignment="Center" />
                                <ui:ToggleSwitch Grid.Column="5" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                 ToolTip="Ligar ou desligar este nível" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

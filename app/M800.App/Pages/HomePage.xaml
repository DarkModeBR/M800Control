<Page x:Class="M800.App.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:M800.App.Controls"
      Title="Início"
      ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="ChipButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <ScrollViewer Style="{StaticResource PageScroll}">
        <StackPanel Style="{StaticResource PagePanel}">
            <TextBlock Text="M800 PRO" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}">
                <Run Text="{Binding ConnectionText, Mode=OneWay}" /><Run Text="  ·  Perfil: " /><Run Text="{Binding ProfileText, Mode=OneWay}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </TextBlock>

            <controls:AdaptiveUniformGrid ItemMinWidth="190" Margin="-4,0">
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Bateria" Style="{StaticResource CardLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="40" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="1.5" CornerRadius="3" Width="37" HorizontalAlignment="Left" />
                                <Border Background="{DynamicResource TextFillColorPrimaryBrush}" Width="3" Height="7" HorizontalAlignment="Right" CornerRadius="1" />
                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}" Width="{Binding BatteryFillWidth}" Height="12" Margin="2,0,0,0" HorizontalAlignment="Left" CornerRadius="1.5" />
                            </Grid>
                            <TextBlock Text="{Binding BatteryText}" Style="{StaticResource CardValue}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BatteryDetail}" Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="DPI atual" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding DpiText}" Style="{StaticResource CardValue}" />
                        <TextBlock Text="{Binding DpiDetail}" Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="4">
                    <StackPanel>
                        <TextBlock Text="Polling rate" Style="{StaticResource CardLabel}" />
                        <TextBlock Text="{Binding PollingText}" Style="{StaticResource CardValue}" />
                        <TextBlock Text="Taxa de resposta do mouse" Style="{StaticResource CardLabel}" />
                    </StackPanel>
                </ui:Card>
            </controls:AdaptiveUniformGrid>

            <TextBlock Text="Troca rápida de DPI" Style="{StaticResource SectionTitle}" />
            <ui:Card>
                <ItemsControl ItemsSource="{Binding DpiChips}" Margin="0,0,0,-8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveUniformGrid ItemMinWidth="100" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Style="{StaticResource ChipButton}" Command="{Binding Command}" ToolTip="{Binding Detail}">
                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" />
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>

            <TextBlock Text="Perfil" Style="{StaticResource SectionTitle}" />
            <ui:Card>
                <ItemsControl ItemsSource="{Binding ProfileChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left" Margin="0,0,8,8" Command="{Binding Command}" Content="{Binding Label}" MinWidth="110" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ui:Card>

            <TextBlock Text="Dispositivo" Style="{StaticResource SectionTitle}" />
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Modelo" Style="{StaticResource CardLabel}" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModelText}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Text="Sensor" Style="{StaticResource CardLabel}" Margin="0,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SensorText}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Text="Faixa de DPI" Style="{StaticResource CardLabel}" Margin="0,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RangeText}" Margin="0,4" />
                    <TextBlock Grid.Row="3" Text="Conexão" Style="{StaticResource CardLabel}" Margin="0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectionText}" Margin="0,4" />
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>

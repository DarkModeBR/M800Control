<ui:FluentWindow x:Class="M800.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:M800.App.Pages"
                 Title="M800 Control"
                 Width="1120" Height="780" MinWidth="480" MinHeight="400"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="M800 Control">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="1"
                           PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" OpenPaneLength="230">
            <ui:NavigationView.Header>
                <StackPanel Margin="{DynamicResource HeaderMargin}">
                    <ui:InfoBar x:Name="StatusBar" IsClosable="False" Margin="0,0,0,6" />
                    <ui:InfoBar x:Name="ErrorBar" IsClosable="True" Severity="Error" Title="Algo deu errado" Margin="0,0,0,6" />
                    <ProgressBar x:Name="SyncProgress" Height="3" Visibility="Collapsed" Margin="0,0,0,6" />
                </StackPanel>
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Início" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:HomePage}" />
                <ui:NavigationViewItem Content="DPI" Icon="{ui:SymbolIcon TopSpeed24}" TargetPageType="{x:Type pages:DpiPage}" />
                <ui:NavigationViewItem Content="Iluminação" Icon="{ui:SymbolIcon Lightbulb24}" TargetPageType="{x:Type pages:LightingPage}" />
                <ui:NavigationViewItem Content="Botões" Icon="{ui:SymbolIcon CursorClick24}" TargetPageType="{x:Type pages:ButtonsPage}" />
                <ui:NavigationViewItem Content="Macros" Icon="{ui:SymbolIcon Keyboard24}" TargetPageType="{x:Type pages:MacrosPage}" />
                <ui:NavigationViewItem Content="Desempenho" Icon="{ui:SymbolIcon Flash24}" TargetPageType="{x:Type pages:PerformancePage}" />
                <ui:NavigationViewItem Content="Energia" Icon="{ui:SymbolIcon WeatherMoon24}" TargetPageType="{x:Type pages:PowerPage}" />
                <ui:NavigationViewItem Content="Ponteiro" Icon="{ui:SymbolIcon Cursor24}" TargetPageType="{x:Type pages:PointerPage}" />
                <ui:NavigationViewItem Content="Testes" Icon="{ui:SymbolIcon Pulse24}" TargetPageType="{x:Type pages:TestsPage}" />
                <ui:NavigationViewItem Content="Perfis" Icon="{ui:SymbolIcon Layer24}" TargetPageType="{x:Type pages:ProfilesPage}" />
                <!-- NAV:menu -->
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Configurações" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
                <!-- NAV:footer -->
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>

<UserControl x:Class="M800.App.Controls.ActionPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:M800.App.Controls"
             Width="660" Height="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="CategoryList" DisplayMemberPath="Name" SelectionChanged="OnCategoryChanged" Margin="0,0,16,0" />
        <Grid Grid.Column="1">
            <ListBox x:Name="OptionList" DisplayMemberPath="Name" Visibility="Collapsed" />

            <StackPanel x:Name="CustomKeyPanel" Visibility="Collapsed">
                <TextBlock Text="Clique no campo e pressione a tecla ou a combinação (ex.: Ctrl + Shift + S)." TextWrapping="Wrap" Margin="0,0,0,10" />
                <controls:KeyCaptureBox x:Name="KeyBox" HorizontalAlignment="Left" />
                <TextBlock Text="Combinações com a tecla Windows estão em “Atalhos prontos”." Style="{StaticResource CardLabel}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="FirePanel" Visibility="Collapsed">
                <TextBlock Text="Repete o clique esquerdo automaticamente." TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Intervalo entre cliques (5 a 255 ms)" />
                <ui:NumberBox x:Name="FireInterval" Minimum="5" Maximum="255" Value="50" MaxDecimalPlaces="0" Width="160" HorizontalAlignment="Left" Margin="0,4,0,12" />
                <TextBlock Text="Quantidade de cliques (0 = enquanto segurar o botão)" />
                <ui:NumberBox x:Name="FireRepeat" Minimum="0" Maximum="255" Value="3" MaxDecimalPlaces="0" Width="160" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel x:Name="MacroPanel" Visibility="Collapsed">
                <TextBlock x:Name="NoMacrosText" Text="Você ainda não tem macros. Crie uma na página Macros." TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Macro" />
                <ComboBox x:Name="MacroCombo" DisplayMemberPath="Name" MinWidth="280" HorizontalAlignment="Left" Margin="0,4,0,12" />
                <TextBlock Text="Executar quantas vezes (1 a 255)" />
                <ui:NumberBox x:Name="MacroRepeat" Minimum="1" Maximum="255" Value="1" MaxDecimalPlaces="0" Width="160" HorizontalAlignment="Left" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
